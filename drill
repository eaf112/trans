local protectedText = {}
local dictionaryLower = {}
for source, translated in pairs(dictionary) do dictionaryLower[source:lower()] = translated end
local termHints = {
	esp = "ESP (위치 표시)", fps = "FPS (화면 부드러움)", fov = "FOV (시야 범위)",
	aimbot = "Aimbot (자동 조준)", afk = "AFK (자리 비움)", hp = "HP (체력)",
	noclip = "Noclip (벽 통과)", ping = "Ping (반응 지연)"
}

local function preserve(text)
	return protectedText[text] or text:match("^@[%w_]+$") or text:find("https?://")
		or text:match("^#[%x]+") or text:find("helio_hub/", 1, true)
end

local function explainTerms(text)
	if preserve(text) then return text end
	return (text:gsub("()(%f[%w][%a][%w]*%f[^%w])()", function(_, word, after)
		local hint = termHints[word:lower()]
		if not hint then return word end
		local suffix = hint:sub(#word + 1)
		if text:sub(after, after + #suffix - 1) == suffix then return word end
		return hint
	end))
end

local state = {}
env.GuiKoreanTranslation = state
local active = true
local entries = {}
local windows = setmetatable({}, {__mode = "k"})
local connections = {}

local function translatePlain(text)
	local leading, body, trailing = text:match("^(%s*)(.-)(%s*)$")
	if protectedText[body] then return text end
	local direct = dictionary[body] or dictionaryLower[body:lower()]
	if direct then
		return leading .. direct .. trailing
	end
	if preserve(body) then return text end
	local key, label = body:match("^(%b[]) (.-) %(Toggle%)$")
	if key then
		if key == "[None]" then key = "[없음]" end
		return leading .. key .. " " .. (dictionary[label] or dictionaryLower[label:lower()] or explainTerms(label)) .. " (켜기/끄기)" .. trailing
	end
	local number, name, price = body:match("^(%d+%. )(.+)( %([^()]+%))$")
	if number and dictionary[name] then
		return leading .. number .. dictionary[name] .. price .. trailing
	end
	local username = body:match("^Welcome, (.+)$")
	if username then return leading .. "환영합니다, " .. username .. trailing end
	local age = body:match("^(%d+%.?%d*) years$")
	if age then return leading .. age .. "년" .. trailing end
	local sec = body:match("^(%d+)s$")
	if sec then return leading .. sec .. "초" .. trailing end
	local ratio = body:match("^Contrast check: good (.+)$")
	if ratio then return leading .. "명암 대비: 양호 " .. ratio .. trailing end
	local version = body:match("^Drill to Earth's Core (.+)$")
	if version then return leading .. "지구 중심까지 굴착 " .. version .. trailing end
	if body:find(" MONITOR ", 1, true) then
		local result = body
		local words = {
			{"MONITOR", "모니터"}, {"enemies", "적"}, {"hits", "피격"},
			{"farm", "파밍"}, {"hold", "보류"}, {"none", "없음"},
			{"now", "현재"}, {"fuel", "연료"}, {"bag", "가방"},
			{"money fog", "돈 안개"}, {"coins/h", "시간당 코인"},
			{"ores", "광석"}, {"deaths", "사망"}, {"escapes", "탈출"},
			{"raids", "레이드"}, {"raid", "레이드"}, {"err", "오류"},
			{"recent", "최근 기록"}, {"SPAWN", "생성"}, {"hp", "체력"},
			{"HP", "체력"}, {"ok", "정상"}, {"OFF", "꺼짐"}, {"ON", "켜짐"},
			{"no", "아니요"}, {"yes", "예"}
		}
		for _, pair in ipairs(words) do
			local pattern = pair[1]:gsub("([^%w])", "%%%1")
			result = result:gsub("%f[%w]" .. pattern .. "%f[^%w]", pair[2])
		end
		return leading .. result .. trailing
	end
	return explainTerms(text)
end

local function translate(text, rich)
	if not rich then return translatePlain(text) end
	local output, index = {}, 1
	while index <= #text do
		local first, last = text:find("<[^>]+>", index)
		if not first then
			output[#output + 1] = translatePlain(text:sub(index))
			break
		end
		output[#output + 1] = translatePlain(text:sub(index, first - 1))
		output[#output + 1] = text:sub(first, last)
		index = last + 1
	end
	return table.concat(output)
end

local function forget(object)
	local entry = entries[object]
	if not entry then return end
	entries[object] = nil
	for _, connection in ipairs(entry.connections) do connection:Disconnect() end
end

local function bind(object)
	if not active or entries[object] then return end
	local property
	if object:IsA("TextBox") then
		property = "PlaceholderText"
	elseif object:IsA("TextLabel") or object:IsA("TextButton") then
		property = "Text"
	else
		return
	end
	local entry = {connections = {}, busy = false}
	entries[object] = entry
	local function update(force)
		if not active or entry.busy then return end
		local ok, current = pcall(function() return object[property] end)
		if not ok then return end
		if current == entry.last then
			if not force then return end
			current = entry.source
		end
		entry.source = current
		local rich = property == "Text" and object.RichText
		local translated = translate(current, rich)
		if translated == current then
			entry.last = nil
			return
		end
		entry.busy = true
		local written = pcall(function() object[property] = translated end)
		entry.busy = false
		if written then
			entry.last = translated
		end
	end
	entry.connections[#entry.connections + 1] = object:GetPropertyChangedSignal(property):Connect(function() update(false) end)
	if property == "Text" then
		entry.connections[#entry.connections + 1] = object:GetPropertyChangedSignal("RichText"):Connect(function()
			update(true)
		end)
	end
	entry.connections[#entry.connections + 1] = object.Destroying:Connect(function() forget(object) end)
	update()
end

local function mount(window)
	if not active or windows[window] then return end
	if not window:IsA("ScreenGui") or window.Name ~= "Obsidian" then return end
	local identified = false
	for _, object in ipairs(window:GetDescendants()) do
		if (object:IsA("TextLabel") or object:IsA("TextButton")) and
			object.Text:lower():find("helio", 1, true) then
			identified = true
			break
		end
	end
	if not identified then return end
	windows[window] = true
	connections[#connections + 1] = window.DescendantAdded:Connect(bind)
	connections[#connections + 1] = window.DescendantRemoving:Connect(forget)
	for _, object in ipairs(window:GetDescendants()) do bind(object) end
end

local rootSet = {}
local function addRoot(root)
	if typeof(root) ~= "Instance" or rootSet[root] then return end
	rootSet[root] = true
	connections[#connections + 1] = root.DescendantAdded:Connect(function(object)
		local cursor = object
		while cursor and cursor ~= root do
			if cursor:IsA("ScreenGui") then mount(cursor) end
			cursor = cursor.Parent
		end
	end)
	for _, object in ipairs(root:GetDescendants()) do
		if object:IsA("ScreenGui") then mount(object) end
	end
end

function state.Stop(restore)
	if not active then return end
	active = false
	for _, connection in ipairs(connections) do connection:Disconnect() end
	local objects = {}
	for object in pairs(entries) do objects[#objects + 1] = object end
	for _, object in ipairs(objects) do
		local entry = entries[object]
		if entry then
			if restore and entry.last then
				pcall(function()
					local property = object:IsA("TextBox") and "PlaceholderText" or "Text"
					if object[property] == entry.last then object[property] = entry.source end
				end)
			end
			forget(object)
		end
	end
	if env.GuiKoreanTranslation == state then env.GuiKoreanTranslation = nil end
end

