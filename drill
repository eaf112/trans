	local players = game:GetService("Players")
	local function protectPlayer(player)
		protectedText[player.Name] = true
		protectedText[player.DisplayName] = true
	end
	for _, player in ipairs(players:GetPlayers()) do protectPlayer(player) end
	connections[#connections + 1] = players.PlayerAdded:Connect(protectPlayer)
end)
pcall(function() addRoot(game:GetService("CoreGui")) end)
pcall(function() addRoot(game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui", 10)) end)
if type(gethui) == "function" then pcall(function() addRoot(gethui()) end) end

return state




